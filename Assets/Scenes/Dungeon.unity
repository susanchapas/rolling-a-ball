--- !u!114 &1708715424
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1708715423}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12cc91c8d39e440d6a35c1e64b27e136, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  speaker: Skeleton Guard
  intro:
  - Halt, priest! You made it all the way to the treasure room... but none shall pass!
  - Unless... I spy those potions you collected. My old bones could use some healing.
  - Give me your healing potion and the treasure is yours. Deal?
  puns:
  - No? I don't have the GUTS to argue... I'm a skeleton!
  - You're a real NUMBSKULL, you know that?
  - I'd fight you for it, but I just don't have the BACKBONE.
  - That answer tickles my FUNNY BONE. Ha... ha...
  - I'll just wait here. I've got a skele-TON of time.
  - Without that potion I'm chilled to the MARROW!
  thanks:
  - A healing potion! I feel BONE-afide fantastic!
  - Thank you, kind priest. The treasure room is all yours.
  - Goodbye, friend! I'm off to rattle somewhere new!
  panel: {fileID: 757642783}
  vanishSound: {fileID: 8300000, guid: 6996c6a6c942c7d4d9f2fb5ab5163fda, type: 3}
